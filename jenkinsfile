pipeline {
    agent any

    environment {
        IMAGE_NAME = "devops-app"
        DOCKER_USER = "<docker-username>"
        DEV_REPO = "dev"
        PROD_REPO = "prod"
        CREDS = "dockerhub-creds"
    }

    stages {

        stage("Checkout Code") {
            steps {
                checkout scm
            }
        }

        stage("Build Docker Image") {
            steps {
                sh "docker build -t $IMAGE_NAME:latest ."
            }
        }

        stage("Push to DEV Repo") {
            when {
                branch "dev"
            }
            steps {
                withCredentials([usernamePassword(
                    credentialsId: CREDS,
                    usernameVariable: 'USER',
                    passwordVariable: 'PASS'
                )]) {
                    sh """
                    echo $PASS | docker login -u $USER --password-stdin
                    docker tag $IMAGE_NAME:latest $DOCKER_USER/$DEV_REPO:latest
                    docker push $DOCKER_USER/$DEV_REPO:latest
                    """
                }
            }
        }

        stage("Push to PROD Repo") {
            when {
                branch "master"
            }
            steps {
                withCredentials([usernamePassword(
                    credentialsId: CREDS,
                    usernameVariable: 'USER',
                    passwordVariable: 'PASS'
                )]) {
                    sh """
                    echo $PASS | docker login -u $USER --password-stdin
                    docker tag $IMAGE_NAME:latest $DOCKER_USER/$PROD_REPO:latest
                    docker push $DOCKER_USER/$PROD_REPO:latest
                    """
                }
            }
        }
    }
}
